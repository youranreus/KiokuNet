{
  "name": "@reus-able/kioku-net",
  "version": "0.4.1",
  "description": "Local-first shared memory for personal agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youranreus/KiokuNet.git"
  },
  "homepage": "https://github.com/youranreus/KiokuNet#readme",
  "bugs": {
    "url": "https://github.com/youranreus/KiokuNet/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "bin": {
    "kioku": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "assets/brand/kiokunet-rounded.png",
    "knowledge"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration/*.test.mjs",
    "prepack": "npm run build",
    "format": "prettier --write src test scripts package.json tsconfig.json",
    "format:check": "prettier --check src test scripts package.json tsconfig.json",
    "test:prepare": "npm run build && node scripts/prepare-tests.mjs",
    "release": "node scripts/release.mjs",
    "release:version": "npm version --no-git-tag-version",
    "release:tags": "git tag --list 'v*' --sort=-version:refname"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
